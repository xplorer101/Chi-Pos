{
  "expo": {
    "name": "ShopPOS",
    "slug": "shoppos",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/z.png",
    "scheme": "shoppos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#F5F7FA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shoppos.app",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "ShopPOS connects to other ShopPOS phones on your shop's Wi-Fi to sync items and sales."
      }
    },
    "android": {
      "package": "com.shoppos.app",
      "versionCode": 3,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.INTERNET"
      ],
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#0E7490",
        "foregroundImage": "./assets/z.png",
        "monochromeImage": "./assets/z.png"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/z.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7490",
          "image": "./assets/z.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ShopPOS uses the camera to scan product barcodes."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidAutobackup": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock ShopPOS with Face ID.",
          "touchIDPermission": "Unlock ShopPOS with fingerprint."
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e01fa98-2f79-423e-979a-c9fbd947dbf0"
      }
    }
  }
}
