{
  "expo": {
    "name": "ShopPOS",
    "slug": "shoppos",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/z.png",
    "scheme": "shoppos",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#F5F7FA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shoppos.app"
    },
    "android": {
      "package": "com.shoppos.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ],
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#0E7490",
        "foregroundImage": "./assets/z.png",
        "monochromeImage": "./assets/z.png"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/z.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7490",
          "image": "./assets/z.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ShopPOS uses the camera to scan product barcodes."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidAutobackup": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock ShopPOS with Face ID."
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
